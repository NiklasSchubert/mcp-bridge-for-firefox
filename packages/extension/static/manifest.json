{
  "manifest_version": 3,
  "name": "Firefox MCP Bridge",
  "version": "0.1.0",
  "description": "Bridges the inspected page's Network/DOM data and screenshots to an MCP server.",
  "devtools_page": "devtools.html",
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": ["tabs"],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; connect-src ws://localhost:8765 ws://127.0.0.1:8765"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "firefox-mcp-bridge@bridge.local",
      "strict_min_version": "128.0"
    }
  }
}
